<%- include('header.ejs') %>

<div class="container mt-5" style="margin-top: 60px;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h3>User Login</h3>
                    <p class="text-muted small">For previously verified users.</p>
                </div>
                <div class="card-body">

                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="alert alert-danger" role="alert">
                            <% if (error === 'not_found') { %>
                                User not found. Please register first.
                            <% } else if (error === 'wrong_dob') { %>
                                The Date of Birth is incorrect.
                            <% } else { %>
                                Invalid login credentials.
                            <% } %>
                        </div>
                    <% } %>

                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label for="aadhaarNumber" class="form-label">Aadhaar Number</label>
                            <input type="text" class="form-control" id="aadhaarNumber" name="aadhaarNumber" required>
                        </div>
                        <div class="mb-3">
                            <label for="dob" class="form-label">Date of Birth</label>
                            <input type="date" class="form-control" id="dob" name="dob" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </form>
                    <div class="text-center mt-3">
                        <a href="/">New User? Verify Here</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('footer.ejs') %>